#ifndef OI_VERSION_H
#define OI_VERSION_H

// Generated by CMake (configure_file) from version.h.in. These are the only
// values that change on every commit, so they're deliberately isolated to
// this one header rather than being blanket compile definitions on the
// OpenIndyApp target - otherwise every one of its ~90 source files would
// need recompiling on every single commit, just to pick up a new hash.

#define OPENINDY_VERSION "@OPENINDY_VERSION@"
#define OPENINDY_COMMIT "@OI_APP_GIT_COMMIT@"
#define OPENINDY_CORE_VERSION "@OI_CORE_GIT_VERSION@"
#define OPENINDY_MATH_VERSION "@OI_MATH_GIT_VERSION@"

#endif // OI_VERSION_H
