---
# C++ Core Guidelines are the style rule set. Checks disabled below are
# deliberate, with the reason given.
Checks: >
  -*,
  cppcoreguidelines-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-loop-convert,
  modernize-use-nodiscard,
  modernize-use-using,
  modernize-make-unique,
  modernize-make-shared,
  misc-throw-by-value-catch-by-reference,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-macro-to-enum,
  -modernize-macro-to-enum,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-avoid-non-const-global-variables
# owning-memory: disabled here. Qt parent/child ownership makes raw `new QWidget(parent)`
#   idiomatic, and the plugin interface still hands out raw owning pointers
#   (migration tracked with the core's unique_ptr work).
# macro-to-enum: OI_PLUGIN_ABI_VERSION must stay a #define (CMake parses it out of plugin_abi.h).
# macro-usage: Q_OBJECT/Q_DECLARE_* (Qt) and OI_DECLARE_PLUGIN* are unavoidable.
# magic-numbers / non-private-members / non-const-globals: too noisy for the
#   legacy code; revisit once the rest is clean.
WarningsAsErrors: ''
HeaderFilterRegex: '(include|src|controller|models|ui|functions|sensors|exchange|cf|tools|simulations)/.*'
FormatStyle: file
