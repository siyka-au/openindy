---
# C++ Core Guidelines are the style rule set. Checks disabled below are
# deliberate, with the reason given.
Checks: >
  -*,
  cppcoreguidelines-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-loop-convert,
  modernize-use-nodiscard,
  modernize-use-using,
  modernize-make-unique,
  modernize-make-shared,
  misc-throw-by-value-catch-by-reference,
  -cppcoreguidelines-owning-memory
# owning-memory: disabled here, 201 findings in the app's own files (controller, models, ui):
#   81 are `new Q*` handed to Qt's parent/child ownership; the rest are raw owning pointers
#   (tree items, delegates, `delete menu`, deleting Guarded<> data) that are released through
#   Qt object trees or by the models and cannot be turned into unique_ptr without
#   restructuring those models. Revisit with core's unique_ptr migration.
WarningsAsErrors: ''
# FormatStyle: file makes clang-tidy format the code its --fix fix-its produce with the .clang-format
#   found by walking up from the source file; it does not change what is reported.
HeaderFilterRegex: '.*/openindy/(controller|models|ui|test)/.*'
FormatStyle: file
